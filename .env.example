# Copy to `.env` (never commit it). EXPO_PUBLIC_* values are bundled into the
# app and are visible to anyone with the binary — never put secrets here
# (no Supabase service-role key, no Firebase service account).

# --- Demo mode: explore every screen with sample data, no backend needed ---
EXPO_PUBLIC_DEMO_MODE=true

# --- Supabase (Project Settings → API) ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY

# --- Firebase (Project settings → Your apps → Web app config) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Google Sign-In (Google Cloud Console → Credentials, same project as Firebase) ---
# Web client ID (used to mint the ID token Firebase verifies)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=XXXX.apps.googleusercontent.com
# iOS client ID (its reversed form becomes the iOS URL scheme automatically)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=XXXX.apps.googleusercontent.com

# --- Links ---
EXPO_PUBLIC_INVITE_BASE_URL=https://evenly.app/j
EXPO_PUBLIC_SUPPORT_EMAIL=support@evenly.app
EXPO_PUBLIC_PRIVACY_URL=https://evenly.app/privacy
EXPO_PUBLIC_TERMS_URL=https://evenly.app/terms

# --- Monitoring (optional; leave empty to disable) ---
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Build-time only (not bundled) ---
APP_BUNDLE_ID=app.evenly.mobile
EAS_PROJECT_ID=
SENTRY_ORG=
SENTRY_PROJECT=
